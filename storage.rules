rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 聊天图片：任何人可读；只能上传 <5MB 的图片文件
    match /images/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
